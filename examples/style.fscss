@import(exec(_init themes)) 

body{
center: both;
bg: @event.theme(dark);
color: @event.theme(light);
} 
pattern(
0.5:
"Hello World card",
`
  rounded: 12px;
  padding: 24px;
  bg: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  box-shadow: 0 8px 24px rgba(0,0,0,0.25);
`)

pattern(0.6: "rounded primary button", `
  border: none;
  rounded: 8px;
  padding: 10px 20px;
  bg: #ffffff;
  color: #764ba2;
  fw: 600;
  cursor: pointer;
`)
