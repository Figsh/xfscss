    "url": "https://github.com/Figsh/xfscss/issues"
  },
  "homepage": "https://fscss.devtem.org",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/Figsh"
  },
  "dependencies": {
    "express": "^5.1.0",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "mocha": "^10.0.0",
    "chai": "^4.3.4"
  }
  "overrides": {
    "array-flatten": "npm:@socketregistry/array-flatten@^1",
